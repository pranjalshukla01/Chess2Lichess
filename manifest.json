{
  "manifest_version": 3,
  "name": "Chess2Lichess",
  "version": "1.0.0",
  "description": "Send a completed Chess.com game to Lichess analysis with one click.",
  "minimum_chrome_version": "105",

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "permissions": ["storage"],

  "host_permissions": ["https://lichess.org/*"],

  "background": {
    "service_worker": "background/background.js"
  },

  "content_scripts": [
    {
      "matches": ["https://www.chess.com/*"],
      "js": ["utils/pgnValidator.js", "content/content.js"],
      "css": ["styles/injected.css"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_title": "Chess2Lichess",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
